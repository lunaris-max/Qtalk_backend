generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int           @id @default(autoincrement())
  email         String?       @unique
  login         String        @unique
  password      String
  firstName     String?       @db.VarChar(20)
  secondName    String?
  description   String?
  avatar        String?
  profileTheme  String?
  age           Int?
  accountStatus AccountStatus @default(ACTIVE)
  gender        Gender        @default(OTHER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  BANNED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}
